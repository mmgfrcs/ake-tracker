<dialog id="refresh-dialog">
  <header>
    <h3>App Update</h3>
  </header>
  <div>
    <p>An updated version of the app is available. Would you like to update the app now?</p>
  </div>
  <footer>
    <button value="nok" commandfor="refresh-dialog" command="close">Update Later</button>
    <button value="ok" commandfor="refresh-dialog" command="close">Update Now</button>
  </footer>
</dialog>