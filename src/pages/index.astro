---
import '@knadh/oat/oat.min.css';
import '../index.css'

import icon from "../assets/icon.png"
import Card from "../components/card.astro"
import PersistenceDialog from "../components/dialogs/persistence.astro"
import RefreshDialog from "../components/dialogs/refresh.astro"
import ExportDialog from "../components/dialogs/export.astro"
import NotusDialog from "../components/dialogs/notus.astro"
import bg from "../assets/bg.webp"
import NewPullSection from "../components/sections/new-pulls.astro"
import PullStatSection from "../components/sections/pull-stats.astro"
import {getImage, Image} from "astro:assets"
import { Download,
  ImageDown,
  MirrorRectangular, LoaderCircle } from '@lucide/astro';
import Pullstats from '../components/pullstats.astro';
import SyncSection from '../components/sections/sync.astro';

const assetMod = import.meta.glob<ImageMetadata>("/src/assets/**/*.{jpg,png,webp}", {import: "default", eager: true})
const optimizedAssetMod: Record<string, string> = {}
for(let assetPth in assetMod) {
  const name = assetPth.match(/[^/\\]+?(?=\.\w+$)/);
  if (!name) continue;

  optimizedAssetMod[assetPth.includes("banners/") ? name[0] + ".webp" : name[0]] = (await getImage({src: assetMod[assetPth], width: assetMod[assetPth].width, format: "webp"})).src
}

const appleIcon = await getImage({src: icon, width: 180, format: "png"})
---

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#574747">
    <link rel="icon" type="image/png" href={icon.src}>
    <link rel="apple-touch-icon" href={appleIcon.src} sizes="180x180">
    <link rel="manifest" href="manifest.webmanifest">

    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AKETracker">
    <meta name="apple-mobile-web-app-title" content="AKETracker">
    <meta name="theme-color" content="#574747">
    <meta name="msapplication-navbutton-color" content="#574747">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="msapplication-starturl" content="/">

    <meta property="og:title" content="AK:E Pull Tracker">
    <meta property="og:description" content="Arknights: Endfield Pull Tracker">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://mmgfrcs.github.io/ake-tracker">
    <meta name="twitter:card" content="summary" />
  </head>
  <body x-data="{glass: true}" x-init="glass = !localStorage.getItem('pref-glass') || localStorage.getItem('pref-glass') === 'true'" x-effect="localStorage.setItem('pref-glass', glass)">
    <div id="assetscoll" data-assets={JSON.stringify(optimizedAssetMod)}></div>
    <div id="bg-image" x-cloak>
      <Image src={bg} x-show="glass" x-transition.duration.500ms.opacity="" x-transition:enter-end="opacity-20" x-transition:leave-start="opacity-20" alt="" />
    </div>
    <header class="flex items-center gap-2 p-4">
      <Image src={icon} class="icon" alt="" width="64" height="64" />
      <h1 class="m-0 flex-1">Arknights: Endfield Pull Tracker <span class="badge vertical-middle" x-data="meta" x-text="'v'+gameVer">-</span></h1>
      <button title="Toggle Glass Effect" class="iconbutton ghost p-0" x-on:click="glass = !glass">
          <MirrorRectangular width="32" height="32" />
      </button>
      <a title="Open Github Repo" href="https://github.com/mmgfrcs/ake-tracker" class="inline-flex">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github-icon lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
      </a>
      <button title="Export as Image" class="iconbutton ghost p-0" x-data="exporter" x-on:click="showExportDialog">
          <ImageDown width="32" height="32" />
      </button>
      <button title="Backup data" class="iconbutton ghost p-0" x-data="backup" x-on:click="await backup()">
          <Download width="32" height="32" />
      </button>
    </header>
    <PersistenceDialog />
    <RefreshDialog />
    <ExportDialog />
    <NotusDialog />
    <main class="w-dvw h-dvh flex flex-col hero-center text-xl" x-show="false">
      <LoaderCircle size={64} /> Loading...
    </main>
    <main class="p-4 flex-1" x-data="pulldata" x-on:data-update.window="await init()">
      <div role="alert" data-variant="warning" x-data="persistence" x-show="!isPersistent" class="mb-4" x-cloak>
        <strong>Data Persistence disabled</strong> 
        <span class="flex-1">Pull Data might be lost when the site is unused or when the browser wants to free up
          storage. Back up your data regularly by clicking on the top right <Download width="16" height="16" /> button</span>
        <button class="textbutton ghost p-0"  x-on:click="await showPersistence()">Enable</button>
      </div>
      <NewPullSection />
      <SyncSection />
      <PullStatSection />

      <ot-tabs x-cloak>
        <div role="tablist">
          <button role="tab">Characters</button>
          <button role="tab">Weapons</button>
        </div>
        <!-- Characters -->
        <Pullstats type='char' />
        <!-- Weapons -->
        <Pullstats type='weapon' />
      </ot-tabs>
    </main>
    <footer class="flex p-4" x-data="meta">
      <p class="flex-1">Copyright © 2026 MIT - See <a href="https://github.com/mmgfrcs/ake-tracker/blob/master/LICENSE">LICENSE</a> for details - <a href="#" x-on:click="document.getElementById('notice-dialog').showModal()">NOTUS</a></p>
      <p x-text="'Version ' + (appVer || 'dev')"></p>
    </footer>
    <script>
      import '@knadh/oat/oat.min.js'
      import db from '../lib/db'
      import Alpine from 'alpinejs';
      import { registerSW } from "virtual:pwa-register";

      const updateSW = registerSW({
        onRegisteredSW(_, reg) {
          console.log("SW registered")
          reg && setInterval(() => {
            reg.update()
            console.log("SW update")
          }, 30000)
        },
        onOfflineReady() {
          //@ts-ignore
          ot.toast("App is ready for offline use", "Offline Ready", { variant: 'success' })
        },
        async onNeedRefresh() {
          const decision = await new Promise<string>(res => {
            const dialog = document.getElementById("refresh-dialog") as HTMLDialogElement
            dialog.addEventListener("close", () => {
              res(dialog.returnValue)
            }, {once: true})
            dialog.showModal()
          })

          if (decision === "ok") await updateSW(true)
        }
      })

      // @ts-ignore
      window.process = {
        nextTick: (fn, ...args) => setTimeout(() => fn(...args)),
      };

      console.log("Loading assets")

      const assetElem = document.getElementById("assetscoll")

      if(assetElem) {
        const optimizedAssetMod = JSON.parse(assetElem.dataset["assets"]!)

        for(let assetPth in optimizedAssetMod) {
          await db.assets.upsert({id: assetPth, value: optimizedAssetMod[assetPth]})
        }

        console.log("Init done")

        Alpine.start()
      } else {
        ot.toast("Cannot load assets", "", {variant: "danger"})
      }

    </script>
  </body>
</html>
